{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:default",
    "updater:default",
    "process:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-execute"
  ]
}
